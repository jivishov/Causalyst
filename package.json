{
  "name": "causalyst",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "frontend",
    "worker"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:worker": "npm run dev --workspace worker",
    "build": "npm run build --workspace shared && npm run build --workspace frontend && npm run build --workspace worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "security": "npm run security:repo && npm run security:dist",
    "security:repo": "node scripts/check-repo-secrets.mjs",
    "security:dist": "node scripts/check-dist-secrets.mjs",
    "test:db": "node scripts/test-db/runner.mjs",
    "test:browser": "playwright test",
    "audit": "npm audit --audit-level=moderate",
    "build:worker": "npm exec --workspace worker -- wrangler deploy --dry-run --outdir ../.worker-build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "db:types": "node scripts/supabase-local.mjs types",
    "db:types:check": "node scripts/supabase-local.mjs check-types",
    "test:supabase": "npm exec --workspace worker -- vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "27.0.0",
    "jsdom": "27.3.0",
    "pg": "8.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
